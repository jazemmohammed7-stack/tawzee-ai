        <testsuite name="PostgreSQL"><directory>tests/Postgres</directory></testsuite>
        <testsuite name="Database"><directory>tests/Database</directory></testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
